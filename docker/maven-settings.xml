<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven settings used only inside the Docker build stage. The container has no
  access to the host's ~/.m2/settings.xml, and direct access to Maven Central is
  unreliable from this network, so the build resolves artifacts through a
  domestic mirror instead.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
    <mirrors>
        <mirror>
            <id>aliyun</id>
            <name>Aliyun public repository</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <mirrorOf>*</mirrorOf>
        </mirror>
    </mirrors>
</settings>
