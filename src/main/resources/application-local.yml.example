# Rename this file to application-local.yml for machine specific settings.
# application-local.yml is ignored by git, so real credentials never leave
# your computer.
#
# Run the application with:  mvn spring-boot:run -Dspring-boot.run.profiles=local

spring:
  datasource:
    url: "jdbc:mysql://localhost:3306/seatflow?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8"
    username: root
    password: change-me

logging:
  level:
    org.hibernate.SQL: debug
