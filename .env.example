# Copy this file to .env and adjust the values for your machine.
# .env is listed in .gitignore and must never be committed.

MYSQL_ROOT_PASSWORD=seatflow

# Used by Spring Boot. If you start MySQL through docker-compose use port 3307,
# if you use a MySQL instance installed on your machine use port 3306.
DB_URL=jdbc:mysql://localhost:3307/seatflow?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8
DB_USERNAME=root
DB_PASSWORD=seatflow

# Signing key for access tokens. Must be at least 32 bytes for HS256.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes
